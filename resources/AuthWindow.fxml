<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="387.0" prefWidth="592.0" style="-fx-background-color: #2E3348;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AuthController">
    <VBox alignment="CENTER" spacing="12.0"
          AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          style="-fx-background-color: transparent;">

        <Label text="Авторизация" textFill="WHITE">
            <font>
                <Font name="JetBrains Mono SemiBold Italic" size="30.0" />
            </font>
        </Label>

        <TextField fx:id="usernameField" promptText="Имя пользователя"
                   maxWidth="400.0" prefHeight="33.0" />

        <PasswordField fx:id="passwordField" promptText="Пароль"
                       maxWidth="400.0" prefHeight="33.0" />

        <Label fx:id="statusLabel" textFill="red" />

        <HBox alignment="CENTER" spacing="15.0">
            <Button fx:id="loginButton" onAction="#onLogin" text="Войти"
                    style="-fx-background-color: #f39c63; -fx-background-radius: 20;"
                    textFill="WHITE" prefHeight="45.0" prefWidth="160.0">
                <font>
                    <Font size="18.0" />
                </font>
            </Button>

            <Button fx:id="registerButton" onAction="#goToRegister" text="Регистрация"
                    style="-fx-background-color: #f39c63; -fx-background-radius: 20;"
                    textFill="WHITE" prefHeight="45.0" prefWidth="160.0">
                <font>
                    <Font size="18.0" />
                </font>
            </Button>
        </HBox>
    </VBox>
</AnchorPane>
