<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Pos?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" spacing="20" alignment="CENTER" fx:controller="client.controllers.DriverWindowController" style="-fx-padding: 30;">
    <Label text="Управление транспортом" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333;"/>

    <!-- Список транспортных средств -->
    <ListView fx:id="vehicleListView" style="-fx-pref-width: 300px; -fx-pref-height: 200px;"/>

    <!-- Кнопка для добавления транспортного средства -->
    <Button text="Добавить транспортное средство" fx:id="addVehicleButton" style="-fx-background-color: #007BFF; -fx-text-fill: white;"/>

    <!-- Статусная метка -->
    <Label fx:id="statusLabel" text="" style="-fx-text-fill: red;"/>
</VBox>
