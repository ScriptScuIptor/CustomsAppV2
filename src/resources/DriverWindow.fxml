<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Label?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" spacing="20" alignment="CENTER" fx:controller="client.controllers.DriverWindowController" style="-fx-padding: 30;">
    <Label text="Мои транспортные средства" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
    <ListView fx:id="vehicleListView" style="-fx-pref-width: 300px; -fx-pref-height: 200px;"/>
    <Button text="Добавить транспорт" fx:id="addVehicleButton" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
</VBox>
