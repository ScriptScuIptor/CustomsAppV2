<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.LoginAttemptsController"
            style="-fx-background-color: #2E3348;" prefWidth="1000" prefHeight="600">

    <top>
        <Label text="История попыток входа"
               style="-fx-font-size: 18px; -fx-text-fill: white;"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="10" alignment="TOP_CENTER" style="-fx-padding: 20;">
            <HBox spacing="10">
                <TextField fx:id="usernameSearchField" promptText="Имя пользователя"/>
                <Button text="Найти" onAction="#onSearch" style="-fx-background-color: #f39c63;" textFill="white"/>
                <Button text="Сбросить" onAction="#onReset" style="-fx-background-color: gray;" textFill="white"/>
            </HBox>

            <TableView fx:id="attemptsTable" prefHeight="500">
                <columns>
                    <TableColumn fx:id="usernameColumn" text="Имя пользователя" prefWidth="300"/>
                    <TableColumn fx:id="successColumn" text="Успешно" prefWidth="150"/>
                    <TableColumn fx:id="timestampColumn" text="Время" prefWidth="400"/>
                </columns>
            </TableView>

            <Label fx:id="statusLabel" textFill="RED"/>
        </VBox>
    </center>
</BorderPane>
