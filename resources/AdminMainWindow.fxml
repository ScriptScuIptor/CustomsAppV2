<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.AdminMainController"
            prefWidth="600" prefHeight="400"
            style="-fx-background-color: #2E3348;">

    <children>
        <Label text="Панель администратора"
               layoutX="180" layoutY="40"
               style="-fx-text-fill: white; -fx-font-size: 22px;" />

        <Button fx:id="usersButton" text="Пользователи"
                layoutX="225" layoutY="100" prefWidth="150" prefHeight="40"
                style="-fx-background-color: #f39c63; -fx-background-radius: 20; -fx-text-fill: white;"
                onAction="#onUsers"/>

        <Button fx:id="requestsButton" text="Заявки"
                layoutX="225" layoutY="160" prefWidth="150" prefHeight="40"
                style="-fx-background-color: #f39c63; -fx-background-radius: 20; -fx-text-fill: white;"
                onAction="#onRequests"/>

        <Button fx:id="statsButton" text="Статистика"
                layoutX="225" layoutY="220" prefWidth="150" prefHeight="40"
                style="-fx-background-color: #f39c63; -fx-background-radius: 20; -fx-text-fill: white;"
                onAction="#onStats"/>

        <Button fx:id="logoutButton" text="Выход"
                layoutX="225" layoutY="280" prefWidth="150" prefHeight="40"
                style="-fx-background-color: #777777; -fx-background-radius: 20; -fx-text-fill: white;"
                onAction="#onLogout"/>
    </children>
</AnchorPane>
